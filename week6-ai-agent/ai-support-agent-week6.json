    },
    {
      "parameters": {
        "description": "Use this tool when the user asks about refunds, returns, or getting money back. Returns the refund policy.",
        "jsCode": "return \"Refunds are available within 14 days of purchase. To request one, contact support with your order number.\";"
      },
      "type": "@n8n/n8n-nodes-langchain.toolCode",
