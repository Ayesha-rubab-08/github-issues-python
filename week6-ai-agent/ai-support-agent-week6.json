    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"answer\": { \"type\": \"string\" },\n    \"tool_used\": { \"type\": \"string\" },\n    \"confidence\": { \"type\": \"string\", \"enum\": [\"high\", \"medium\", \"low\"] }\n  },\n  \"required\": [\"answer\", \"tool_used\", \"confidence\"]\n}"
      },
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        592,
        400
      ],
      "id": "90e5ccf2-4b69-4c03-98a2-133e85e1078d",
      "name": "Structured Output Parser"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const out = $json.output;\nconst allowedTools = [\"get_password_reset_steps\", \"get_refund_policy\", \"none\"];\nconst allowedConfidence = [\"high\", \"medium\", \"low\"];\nconst errors = [];\n\nif (!out || typeof out !== \"object\") {\n  errors.push(\"output missing\");\n} else {\n  if (typeof out.answer !== \"string\" || out.answer.trim() === \"\") {\n    errors.push(\"answer is empty\");\n  }\n  if (!allowedTools.includes(out.tool_used)) {\n    errors.push(\"unknown tool_used: \" + out.tool_used);\n  }\n  if (!allowedConfidence.includes(out.confidence)) {\n    errors.push(\"invalid confidence: \" + out.confidence);\n  }\n}\n\nreturn {\n  json: {\n    valid: errors.length === 0,\n    errors: errors,\n    result: out || null\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
